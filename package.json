{
  "name": "crud-integrasi",
  "version": "1.0.0",
  "description": "API REST para Gestão de Estoque desenvolvida na oficina de Node.js, TypeScript e MongoDB",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "seed": "npx ts-node src/seed.ts",
